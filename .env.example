# Blender service runtime
FLASK_ENV=production
GENERATE_TIMEOUT_SECONDS=120
OCI_CLEANUP_LOCAL_FILES=true

# REQUIRED. Shared secret sent by the Spring backend as the X-Blender-Token header.
# The service refuses to start without it (min 32 chars). Generate with:
#   openssl rand -hex 32
# Must match BLENDER_SERVICE_TOKEN on the backend exactly.
BLENDER_SERVICE_TOKEN=

# Render capacity. Each concurrent Blender import of a large GLB costs a multiple of
# the file size in RAM, so keep this at 1 on a small VM and raise it only with memory
# headroom. Requests beyond the cap wait RENDER_WAIT_SECONDS then get 503 + Retry-After
# (set the wait to 0 to reject immediately).
MAX_CONCURRENT_RENDERS=1
RENDER_WAIT_SECONDS=30
SERVER_THREADS=8

# Host interface the container port is published on. Use the VM's PRIVATE VCN address
# in production - never 0.0.0.0. Defaults to loopback so a misconfigured deploy fails
# closed rather than exposing the render API.
BLENDER_BIND_ADDRESS=127.0.0.1

# OCI Object Storage (recommended for production)
OCI_OBJECT_STORAGE_ENABLED=true
OCI_REGION=ap-hyderabad-1
OCI_AUTH_MODE=instance_principal
OCI_NAMESPACE=
OCI_BUCKET_NAME=ar-models
OCI_MODELS_PREFIX=models/
OCI_GENERATED_PREFIX=generated/
OCI_CONFIG_FILE=/home/blender/.oci/config
OCI_CONFIG_PROFILE=DEFAULT
OCI_CONFIG_DIR=/home/your-user/.oci

# Optional override when using a custom object storage domain/CDN
# OCI_PUBLIC_BASE_URL=https://objectstorage.ap-hyderabad-1.oraclecloud.com/n/<namespace>/b/ar-models/o
